# Changelog

Generated by [`auto-changelog`](https://github.com/CookPete/auto-changelog) with [custom template](.github/CHANGELOG_TEMPLATE.hbs)

---
{{#each releases}}

    {{#if href}}
        ## [{{title}}]({{href}}){{#if tag}} - {{isoDate}}{{/if}}
    {{else}}
        ## {{title}}{{#if tag}} - {{isoDate}}{{/if}}
    {{/if}}
    {{#if merges}}
        {{#each merges}}
            - [{{#if href}}[`#{{id}}`]({{href}}){{/if}}] {{message}}
        {{/each}}
    {{/if}}
    {{#if fixes}}
        {{#each fixes}}
            - [{{#each fixes}}{{#if href}}[`#{{id}}`]({{href}}){{/if}}{{/each}}] {{commit.subject}}
        {{/each}}
    {{/if}}
    {{#if commits}}
        {{#each commits}}
            - [{{#if href}}[`{{shorthash}}`]({{href}}){{/if}}] {{subject}} - {{author}}
        {{/each}}
    {{/if}}
{{/each}}
